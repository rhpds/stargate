# ============================================================
# StarGate Platform — Environment Variables
# ============================================================
# Copy to .env and fill in values. NEVER commit .env files.
# All secrets must be env vars — never hardcode in source.
# ============================================================

# --- Database ---
# In-cluster: use the k8s service name. Locally: use localhost.
# NOTE: Do NOT use $(SHELL_VAR) syntax — Python reads env vars literally.
# For k8s, inject the password via Secret envFrom or a deploy script.
STARGATE_DATABASE_URL=postgresql://stargate:PASSWORD@localhost:5432/stargate

# --- LLM / MAAS ---
STARGATE_LITELLM_API_KEY=           # LiteLLM virtual key from MAAS
STARGATE_LITELLM_URL=               # LiteLLM endpoint URL
STARGATE_LLM_MODEL=granite-3-2-8b-instruct

# --- Admin Auth ---
STARGATE_ADMIN_API_KEY=             # API key for admin endpoints (generated at deploy)

# --- External Data Sources ---
STARGATE_LABAGATOR_URL=             # Labagator REST API base URL
STARGATE_DEMOLITION_URL=            # Demolition REST API base URL
STARGATE_SANDBOX_API_METRICS_URL=   # Sandbox API Prometheus metrics endpoint
STARGATE_DASHBOARD_URL=             # Public dashboard URL (for Slack notifications)

# --- OAuth ---
STARGATE_OAUTH_COOKIE_SECRET=       # Random 32-char hex (openssl rand -hex 16)

# --- AgnosticV ---
STARGATE_AGNOSTICV_TOKEN=           # GitHub PAT for AgnosticV repo clone
STARGATE_AGNOSTICV_DIR=             # Local path to AgnosticV checkout

# --- Scanner ---
STARGATE_CLUSTERS=                  # Comma-separated cluster names or JSON dict
STARGATE_CLUSTER_URLS=              # JSON dict of cluster→Thanos URL mappings
STARGATE_SSL_VERIFY=true            # Set to "false" for internal self-signed certs
STARGATE_MEMORY_DIAGNOSTICS=false   # Temporary RSS/allocation logging; adds tracing overhead
STARGATE_RUNTIME_TIMING=false      # Temporary stage timing/RSS counters only; no payloads or tracing
STARGATE_ADJUDICATION_ENABLED=false # Model review only; never enables remediation
STARGATE_ADJUDICATION_REVIEWERS=     # Exactly two distinct model IDs
STARGATE_ADJUDICATION_JUDGE=         # Third distinct model ID
STARGATE_ADJUDICATION_DAILY_LIMIT=20 # Shared UTC-day reservation budget across replicas

# --- Execution ---
STARGATE_STATELESS_PILOT_TARGET=   # Optional JSON for advisory test-only assessment; never enables execution
STARGATE_EXECUTION_TARGET=mock      # mock | test | production
STARGATE_REMEDIATION_NS=launchpad-,stargate,deepfield,intel-rh-,user-demo-,partner-ai-  # Namespace prefixes allowed for remediation
STARGATE_DRY_RUN=true               # Set to "false" to enable real execution
STARGATE_TEST_NAMESPACE=stargate-test
STARGATE_CONFIDENCE_THRESHOLD=0.8

# --- Event Filtering ---
STARGATE_EVENT_PREFIX=              # e.g., "summit-2026" — empty = all events
STARGATE_EVENT_DATE=                # ISO date for event countdown
STARGATE_EVENT_NAME=Platform Operations

# --- Notifications ---
STARGATE_SLACK_WEBHOOK_URL=         # Slack incoming webhook for alerts
STARGATE_WEBHOOK_URL=               # Generic webhook URL

# --- Integrations ---
STARGATE_LAUNCHPAD_URL=             # Launchpad API URL for session data
STARGATE_LAUNCHPAD_API_KEY=         # Launchpad API key
STARGATE_DEEPFIELD_URL=             # DeepField API URL
STARGATE_SANDBOX_API_URL=           # Sandbox API base URL (for RHDP actions)
STARGATE_ZEROTOUCH_URL=             # ZeroTouch API URL
STARGATE_EXECUTOR_KUBECONFIG=       # Kubeconfig path for remediation execution

# --- AgnosticV ---
STARGATE_AGNOSTICV_REPO=            # AgnosticV git repo URL

# --- LLM Advanced ---
STARGATE_AUTO_LLM=                  # Enable auto-LLM classification (true/false)
STARGATE_LLM_COST_PROMPT=0.003     # Cost per 1K prompt tokens
STARGATE_LLM_COST_COMPLETION=0.006 # Cost per 1K completion tokens
STARGATE_EVIDENCE_SOURCE=real       # real | synthetic

# --- Scanner Advanced ---
STARGATE_CLUSTERS_FILE=             # Path to YAML clusters config file
STARGATE_AAP_EVENT=                 # AAP event prefix filter
ALERTMANAGER_URL=                   # Alertmanager API endpoint URL

# --- Deploy ---
STARGATE_CLUSTER=                   # OpenShift API server URL (for deploy scripts)
STARGATE_REGISTRY=                  # OpenShift image registry route (for deploy scripts)

# --- CORS ---
STARGATE_CORS_ORIGINS=http://localhost:3000,http://localhost:8090

# --- Additional config ---
STARGATE_API_URL=
STARGATE_ECOSYSTEM_NS=
STARGATE_GEOLUX_URL=
STARGATE_INLINE_SCANNER=
STARGATE_TRUST_PROXY_AUTH=

# --- Optional settings (commented: do not override runtime defaults) ---
# Legacy LLM aliases / per-investigation override. Leave unset to inherit configuration.
# STARGATE_LLM_URL=
# STARGATE_LLM_API_KEY=
# STARGATE_AGENT_MODEL=
# STARGATE_INVESTIGATION_USAGE_CANARY_PERCENT=10

# Investigation scheduling only; this does not enable infrastructure remediation.
# STARGATE_AUTO_INVESTIGATE=false
# STARGATE_INVESTIGATE_MAX_PER_SCAN=10
# STARGATE_INVESTIGATE_MAX_PER_DAY=200
# STARGATE_INVESTIGATE_MAX_PER_CATALOG_HOUR=3
# STARGATE_INVESTIGATE_DEDUP_HOURS=4
# STARGATE_INVESTIGATE_PATTERN_DEDUP_HOURS=2
# STARGATE_INVESTIGATE_SKIP_SELF_RESOLVE_PCT=50
# STARGATE_INVESTIGATE_PERSISTENT_HOURS=4

# Collector inputs, process placement and retention. Credentials stay external.
# STARGATE_AAP_CONTROLLERS_FILE=
# STARGATE_AAP_EVENT0_URL=
# STARGATE_SANDBOX_API_TOKEN=
# STARGATE_INCLUDE_NS=
# STARGATE_EXCLUDE_NS=
# STARGATE_API_CLIENT_TIMEOUT=60
# STARGATE_API_BABYLON_COLLECTION=false
# STARGATE_API_CORPUS_MINING=false
# STARGATE_WORKSHOP_PROVISION_NAMESPACES=
# STARGATE_WORKSHOP_PROVISION_STALL_HOURS=1
# STARGATE_STUCK_TEARDOWN_HOURS=2          # AnarchySubject destroying/destroy-failed age before teardown_stuck
# STARGATE_GAP_DEDUP_HOURS=24              # Gap-detection episode window: refresh inside, new episode after
# STARGATE_ANARCHY_NAMESPACES=-A           # AnarchySubject namespaces to scan (comma-separated or -A for all)
# STARGATE_GAP_KUBECONFIG=                 # Kubeconfig for gap detectors (default: Babylon control-plane kubeconfig)
# STARGATE_SCAN_SNAPSHOT_RETENTION_DAYS=7
# STARGATE_SCAN_SNAPSHOT_CLEANUP_BATCH=1000

# Optional outbound integrations. No service URLs or credentials are supplied here.
# STARGATE_DEEPFIELD_INTERNAL_URL=
# STARGATE_GEOLUX_API_KEY=
# STARGATE_JIRA_ISSUE_TYPE=Task

# Estimated capacity unit costs, not measured billing rates.
# STARGATE_COST_VCPU_HOUR=0.05
# STARGATE_COST_MEMORY_GI_HOUR=0.01
# STARGATE_COST_STORAGE_GI_HOUR=0.0001
STARGATE_ASK_MODEL=qwen3-14b             # Model for MCP ask tool (qwen3-14b measured 6.6s vs 30s+ for llama-scout)
